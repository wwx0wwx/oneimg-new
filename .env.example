# JWT 签名密钥（不设则自动生成并持久化到数据库 settings.db）
JWT_SECRET=

# 通知密钥等敏感配置的加密主密钥（不设则从 JWT_SECRET 派生）
ONEIMG_SECRET_KEY=

# 数据/上传目录（默认生产 /app，会生成 <dir>/db 与 <dir>/uploads）
ONEIMG_DATA_DIR=

# 信任反向代理的 X-Forwarded-For（部署在 nginx/CF 后设 1；直连暴露时保持空）
TRUST_PROXY=

# nsfwdet 检测服务密钥（仅服务端使用）
NSFWDET_API_KEY=

# tg发送消息的反代地址
TELEGRAM_API_URL=
